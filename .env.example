NODE_ENV=production
APP_ORIGIN=https://your-secure-api.example.com
FRONTEND_URL=https://gomayoha.github.io/ilp-internal-portal/
HOST=0.0.0.0
PORT=4173
MS_TENANT_ID=
MS_SPA_CLIENT_ID=
